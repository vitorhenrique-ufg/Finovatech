{
  "ConnectionStrings": {
    "Redis": "localhost:16379"
  },
  "Jwt": {
    "ChaveSecreta": "finovatech-super-secret-key-2026-production!",
    "Emissor": "finovatech",
    "Audiencia": "novamart"
  },
  "ReverseProxy": {
    "Routes": {
      "route-payments": {
        "ClusterId": "gateway-pagamento",
        "Match": { "Path": "/payments/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "route-catalog": {
        "ClusterId": "servico-catalogo",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "route-hubs": {
        "ClusterId": "servico-notificacao",
        "Match": { "Path": "/hubs/{**catch-all}" },
        "AuthorizationPolicy": "default"
      },
      "route-notifications-public": {
        "ClusterId": "servico-notificacao",
        "Match": { "Path": "/notifications/vapid-public-key" }
      },
      "route-notifications": {
        "ClusterId": "servico-notificacao",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "gateway-pagamento":   { "Destinations": { "primary": { "Address": "http://finovatech-gateway-pagamento:8080" } } },
      "servico-catalogo":    { "Destinations": { "primary": { "Address": "http://finovatech-servico-catalogo:8080" } } },
      "servico-notificacao": { "Destinations": { "primary": { "Address": "http://finovatech-servico-notificacao:8080" } } }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Information" } },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  }
}
