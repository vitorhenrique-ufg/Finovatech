@using NovaMart.Frontend.Servicos
@inject IServicoAssinaturaPush PushSvc
@inject IJSRuntime JS

@if (_visivel)
{
    <!-- Backdrop -->
    <div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-end sm:items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden animate-in">

            <!-- Ícone + cabeçalho -->
            <div class="bg-gradient-to-br from-cyan-500 to-cyan-600 px-6 pt-6 pb-8 text-center">
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-bell text-white text-2xl"></i>
                </div>
                <h2 class="text-xl font-black text-white">Ativar notificações?</h2>
                <p class="text-cyan-100 text-sm mt-1">Fique por dentro dos seus pedidos em tempo real</p>
            </div>

            <!-- Benefícios -->
            <div class="px-6 py-5 space-y-3">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fa-solid fa-circle-check text-green-600 text-sm"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900">Pagamento aprovado</p>
                        <p class="text-xs text-slate-500">Saiba na hora quando seu pedido for aprovado</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 bg-cyan-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fa-solid fa-shield-halved text-cyan-600 text-sm"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-900">Alertas de segurança</p>
                        <p class="text-xs text-slate-500">Receba alertas sobre transações suspeitas</p>
                    </div>
                </div>
            </div>

            <!-- Botões -->
            <div class="px-6 pb-6 space-y-2">
                <button @onclick="AtivarAsync"
                    disabled="@_carregando"
                    class="w-full bg-cyan-500 hover:bg-cyan-400 text-white font-bold py-3 rounded-xl transition-colors flex items-center justify-center gap-2 disabled:opacity-60">
                    @if (_carregando)
                    {
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Ativando...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-bell"></i>
                        <span>Sim, quero ser notificado</span>
                    }
                </button>
                <button @onclick="RecusarAsync"
                    class="w-full text-slate-500 hover:text-slate-700 text-sm py-2 transition-colors">
                    Agora não
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<bool> OnResultado { get; set; }

    private bool _visivel;
    private bool _carregando;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        bool suportado = await JS.InvokeAsync<bool>("PushInterop.isSupported");
        if (!suportado) return;

        string permissao = await JS.InvokeAsync<string>("PushInterop.getPermissionState");
        if (permissao == "denied") return; // já negou — não pergunta de novo

        bool jaPerguntou = await PushSvc.VerifiquePedidoPermissaoMostradoAsync();
        if (jaPerguntou) return;

        _visivel = true;
        StateHasChanged();
    }

    private async Task AtivarAsync()
    {
        _carregando = true;
        StateHasChanged();

        await PushSvc.MarquePedidoPermissaoMostradoAsync();
        bool ativado = await PushSvc.AtiveAsync();
        _visivel = false;
        _carregando = false;
        await OnResultado.InvokeAsync(ativado);
    }

    private async Task RecusarAsync()
    {
        await PushSvc.MarquePedidoPermissaoMostradoAsync();
        _visivel = false;
        await OnResultado.InvokeAsync(false);
    }
}
