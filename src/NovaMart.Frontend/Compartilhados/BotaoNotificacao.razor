@using NovaMart.Frontend.Modelos
@using NovaMart.Frontend.Servicos
@inject IServicoAssinaturaPush PushSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="relative">
        <button @onclick="ToggleDropdownAsync"
            title="Notificações"
            class="relative flex items-center justify-center w-9 h-9 bg-white border border-slate-200 rounded-lg hover:border-cyan-300 transition-colors">
            <i class="fa-@(_notificacoes.Any() ? "solid" : "regular") fa-bell text-slate-600 text-sm"></i>
            @if (_naoLidas > 0)
            {
                <span class="absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] px-1 bg-red-500 text-white text-[10px] font-black rounded-full flex items-center justify-center">
                    @(_naoLidas > 9 ? "9+" : _naoLidas.ToString())
                </span>
            }
        </button>

        @if (_aberto)
        {
            <div class="fixed inset-0 z-40" @onclick="FecharDropdown"></div>
            <div class="absolute right-0 top-11 w-80 bg-white border border-slate-200 rounded-xl shadow-xl overflow-hidden z-50">

                <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">
                    <h3 class="text-sm font-bold text-slate-900">Notificações</h3>
                    @if (_naoLidas > 0)
                    {
                        <button @onclick="MarcarTodasLidasAsync" @onclick:stopPropagation="true"
                            class="text-xs text-cyan-600 hover:text-cyan-500 font-medium transition-colors">
                            Marcar todas como lidas
                        </button>
                    }
                </div>

                <div class="max-h-80 overflow-y-auto">
                    @if (!_notificacoes.Any())
                    {
                        <div class="flex flex-col items-center justify-center py-10 text-slate-400">
                            <i class="fa-regular fa-bell-slash text-3xl mb-2"></i>
                            <p class="text-sm font-medium">Nenhuma notificação</p>
                            <p class="text-xs mt-1">Você será avisado sobre seus pedidos aqui</p>
                        </div>
                    }
                    else
                    {
                        @foreach (NotificacaoItem notif in _notificacoes)
                        {
                            <button @onclick="() => AbrirNotificacaoAsync(notif)"
                                class="w-full flex items-start gap-3 px-4 py-3 hover:bg-slate-50 transition-colors border-b border-slate-50 text-left">
                                <div class="relative flex-shrink-0 mt-0.5">
                                    <div class="w-8 h-8 rounded-full flex items-center justify-center
                                        @(notif.Titulo.Contains("Aprovado") ? "bg-green-100" : "bg-red-100")">
                                        <i class="text-xs @(notif.Titulo.Contains("Aprovado") ? "fa-solid fa-circle-check text-green-600" : "fa-solid fa-circle-xmark text-red-500")"></i>
                                    </div>
                                    @if (!notif.Lida)
                                    {
                                        <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-cyan-500 rounded-full border-2 border-white"></span>
                                    }
                                </div>

                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-slate-900 truncate @(notif.Lida ? "font-medium text-slate-600" : "")">
                                        @notif.Titulo
                                    </p>
                                    <p class="text-xs text-slate-500 mt-0.5 line-clamp-2">@notif.Corpo</p>
                                    <p class="text-[10px] text-slate-400 mt-1">@FormatarTempo(notif.Tempo)</p>
                                </div>
                            </button>
                        }
                    }
                </div>
            </div>
        }
    </div>

@code {
    private bool _pushSuportado;
    private bool _aberto;
    private int _naoLidas;
    private List<NotificacaoItem> _notificacoes = [];
    private DotNetObjectReference<BotaoNotificacao>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _pushSuportado = await JS.InvokeAsync<bool>("PushInterop.isSupported");
        if (!_pushSuportado) return;

        await CarregueNotificacoesAsync();

        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("PushInterop.registrarCallbackNotificacao", _selfRef);
    }

    [JSInvokable]
    public async Task OnNovaNotificacaoRecebida()
    {
        await CarregueNotificacoesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CarregueNotificacoesAsync()
    {
        _notificacoes = await PushSvc.ConsulteNotificacoesAsync();
        _naoLidas     = await PushSvc.ContarNaoLidasAsync();
    }

    private async Task ToggleDropdownAsync()
    {
        _aberto = !_aberto;
        if (_aberto)
            await CarregueNotificacoesAsync();
    }

    private void FecharDropdown() => _aberto = false;

    private async Task MarcarTodasLidasAsync()
    {
        await PushSvc.MarqueTodasLidasAsync();
        await CarregueNotificacoesAsync();
        StateHasChanged();
    }

    private async Task AbrirNotificacaoAsync(NotificacaoItem notif)
    {
        _aberto = false;
        await PushSvc.MarqueTodasLidasAsync();
        _naoLidas = 0;

        if (!string.IsNullOrWhiteSpace(notif.Url))
            Nav.NavigateTo(notif.Url);
    }

    private static string FormatarTempo(string iso)
    {
        if (!DateTimeOffset.TryParse(iso, out DateTimeOffset dt)) return "";
        DateTimeOffset local = dt.ToLocalTime();
        TimeSpan diff = DateTimeOffset.Now - local;

        return diff.TotalMinutes < 1  ? "agora"
             : diff.TotalMinutes < 60 ? $"há {(int)diff.TotalMinutes} min"
             : diff.TotalHours < 24   ? $"há {(int)diff.TotalHours}h"
             : local.ToString("dd/MM HH:mm");
    }

    public void Dispose()
    {
        _selfRef?.Dispose();
        _ = JS.InvokeVoidAsync("PushInterop.removerCallbackNotificacao");
    }
}
