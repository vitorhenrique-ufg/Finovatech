@inject IJSRuntime JS

<div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white">
    <div class="relative aspect-square overflow-hidden">
        @if (!string.IsNullOrEmpty(ImagemAtual))
        {
            <img src="@ImagemAtual" alt="@NomeProduto — imagem @(_indiceAtual + 1)"
                 class="w-full h-full object-cover transition-opacity duration-300"
                 loading="lazy" />
        }

        @if (Imagens.Count > 1)
        {
            <button @onclick="Anterior"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/80 border border-slate-200 backdrop-blur flex items-center justify-center text-slate-700 hover:border-cyan-500/50 transition-colors z-10">
                &#8249;
            </button>
            <button @onclick="Proximo"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/80 border border-slate-200 backdrop-blur flex items-center justify-center text-slate-700 hover:border-cyan-500/50 transition-colors z-10">
                &#8250;
            </button>

            <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10">
                @for (int i = 0; i < Imagens.Count; i++)
                {
                    int idx = i;
                    <button @onclick="() => VaParaIndice(idx)"
                        class="transition-all duration-200 rounded-full @(idx == _indiceAtual ? "w-5 h-1.5 bg-cyan-500" : "w-1.5 h-1.5 bg-slate-300 hover:bg-slate-400")">
                    </button>
                }
            </div>
        }
    </div>

    @if (Imagens.Count > 1)
    {
        <div class="flex gap-2 p-3 bg-slate-50 border-t border-slate-200 overflow-x-auto">
            @for (int i = 0; i < Imagens.Count; i++)
            {
                int idx = i;
                string url = Imagens[idx];
                <button @onclick="() => VaParaIndice(idx)"
                    class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 transition-all duration-200 @(idx == _indiceAtual ? "border-cyan-500" : "border-slate-200 hover:border-cyan-300")">
                    <img src="@url" alt="@NomeProduto thumbnail @(idx + 1)"
                         class="w-full h-full object-cover" loading="lazy" />
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required string NomeProduto { get; set; }
    [Parameter, EditorRequired] public required IReadOnlyList<string> Imagens { get; set; }

    private int _indiceAtual;
    private string ImagemAtual => Imagens.Count > 0 ? Imagens[_indiceAtual] : string.Empty;

    private void Anterior()
    {
        _indiceAtual = _indiceAtual == 0 ? Imagens.Count - 1 : _indiceAtual - 1;
    }

    private void Proximo()
    {
        _indiceAtual = _indiceAtual == Imagens.Count - 1 ? 0 : _indiceAtual + 1;
    }

    private void VaParaIndice(int indice)
    {
        _indiceAtual = indice;
    }
}
